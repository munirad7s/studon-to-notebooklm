{
  "manifest_version": 3,
  "name": "StudOn to NotebookLM",
  "version": "1.0.2",
  "description": "1-Click export of FAU StudOn course materials, slides, and notes into NotebookLM & Google Drive or structured ZIP.",
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon_16.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.studon.fau.de/studon/*"
      ],
      "js": [
        "content/content.bundle.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "identity"
  ],
  "host_permissions": [
    "https://www.studon.fau.de/*",
    "https://notebooklm.google.com/*",
    "https://www.googleapis.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "lib/*",
        "content/*"
      ],
      "matches": [
        "https://www.studon.fau.de/*"
      ]
    }
  ]
}
