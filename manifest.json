{
  "manifest_version": 3,
  "name": "StudOn → NotebookLM",
  "version": "2.1.0",
  "description": "Exportiert komplette FAU-StudOn-Kurse (Ordner, Dateien, Lernmodule, Übungen, Sitzungen, Links) direkt in Google NotebookLM – optional gespiegelt nach Google Drive oder als ZIP.",
  "key": "",
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "StudOn → NotebookLM",
    "default_icon": {
      "16": "icons/icon_16.png",
      "48": "icons/icon_48.png",
      "128": "icons/icon_128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service_worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.studon.fau.de/studon/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "downloads",
    "identity",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.studon.fau.de/*",
    "https://notebooklm.google.com/*",
    "https://notebook.google.com/*",
    "https://www.googleapis.com/*",
    "https://www.fau.tv/*",
    "https://fau.tv/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/content.css"
      ],
      "matches": [
        "https://www.studon.fau.de/*"
      ]
    }
  ]
}
